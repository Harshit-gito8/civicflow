# CivicFlow Client Environment Configuration

# Backend API endpoint (defaults to http://localhost:5000/api in development)
VITE_API_URL=http://localhost:5000/api

# OPTIONAL: Mapbox Access Token (100% FREE Tier from https://account.mapbox.com)
# If left blank, the app automatically loads free CartoDB Voyager, Dark View, and OpenStreetMap tiles with ZERO API key required!
VITE_MAPBOX_TOKEN=
